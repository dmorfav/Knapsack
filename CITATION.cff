  - family-names: "Herrera-Franklin"
    given-names: "Jorge"
repository-code: "https://github.com/dmorfav/Knapsack"
url: "https://dmorfav.github.io/Knapsack/"
license: GPL-3.0-or-later
keywords:
  - knapsack problem
  - metaheuristics
  - benchmarking
  - combinatorial optimization
